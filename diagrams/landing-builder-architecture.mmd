    Visitor(["Visitor"])

    C --> B
    S --> B
    PP --> B

    B -->|"PATCH autosave\nlayout jsonb"| PC
    B -->|"POST /publish"| PC
    B -->|"GET /publication_status\npoll 1s"| PC

    PC -->|"save layout"| PG
    PC -->|"enqueue"| RD
    PG -->|"published_at"| PC

    RD -->|"dequeue"| SK
    SK --> JB
