graph TD
    subgraph FE ["Vue Frontend"]
        B["Builder.vue\nstate · publish · poll"]
        C["Canvas.vue\ndrag · resize · select"]
        S["Sidebar.vue\nadd elements"]
        PP["PropertiesPanel.vue\nedit styles"]
    end

    subgraph Rail ["Rails Web"]
        PC["PagesController\nupdate · publish\npublication_status"]
        PPC["PublicPagesController\nshow /p/:slug"]
    end

    subgraph Store ["Storage"]
        PG[("PostgreSQL\npages · page_publications\nusers")]
        RD[("Redis\nSidekiq queue + cache")]
