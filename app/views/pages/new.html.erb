<div style="max-width: 480px; margin: 0 auto; padding: 32px 24px;">
  <div style="margin-bottom: 28px;">
    <a href="/pages" style="font-size: 13px; color: #6B6B64; text-decoration: none;">← My Pages</a>
  </div>

  <h1 style="margin-bottom: 24px;">New Page</h1>

  <%= form_with model: @page, url: pages_path do |f| %>
    <% if @page.errors.any? %>
      <div style="padding: 12px 16px; background: #FCECEA; border: 1px solid #C0392B; border-radius: 6px; color: #C0392B; font-size: 13px; margin-bottom: 20px;">
        <%= @page.errors.full_messages.join(", ") %>
      </div>
    <% end %>

    <div style="display: flex; flex-direction: column; gap: 5px; margin-bottom: 24px;">
      <%= f.label :title, "Page title", style: "font-size: 13px; font-weight: 500; color: #1A1A17;" %>
      <%= f.text_field :title,
            placeholder: "e.g. Summer Sale",
            style: "padding: 8px 11px; border: 1px solid #E3E3DF; border-radius: 6px; font-size: 14px; color: #1A1A17; background: white; outline: none; width: 100%; margin-top: 2px;" %>
    </div>

    <%= f.submit "Create Page",
          style: "padding: 9px 16px; background: #0a7065; color: white; border: none; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer;" %>
  <% end %>
</div>
