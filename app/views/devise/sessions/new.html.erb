<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #F5F5F2; padding: 24px;">
  <div style="width: 100%; max-width: 400px;">

    <div style="text-align: center; margin-bottom: 32px;">
      <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #0a7065; border-radius: 10px; margin-bottom: 16px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="3" width="8" height="8" rx="1.5" fill="white"/>
          <rect x="13" y="3" width="8" height="5" rx="1.5" fill="white" opacity="0.6"/>
          <rect x="3" y="13" width="5" height="8" rx="1.5" fill="white" opacity="0.6"/>
          <rect x="10" y="10" width="11" height="11" rx="1.5" fill="white"/>
        </svg>
      </div>
      <h1 style="font-size: 1.375rem; font-weight: 700; color: #1A1A17; margin: 0 0 4px;">Sign in</h1>
      <p style="font-size: 14px; color: #6B6B64; margin: 0;">Landing Page Builder</p>
    </div>

    <div style="background: white; border: 1px solid #E3E3DF; border-radius: 10px; padding: 32px; box-shadow: 0 1px 4px rgba(0,0,0,0.06);">

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div style="margin-bottom: 18px;">
          <%= f.label :email, "Email", style: "display: block; font-size: 13px; font-weight: 500; color: #1A1A17; margin-bottom: 5px;" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                placeholder: "you@example.com",
                style: "display: block; width: 100%; padding: 9px 11px; border: 1px solid #E3E3DF; border-radius: 6px; font-size: 14px; color: #1A1A17; background: white; box-sizing: border-box; outline: none;" %>
        </div>

        <div style="margin-bottom: 24px;">
          <%= f.label :password, "Password", style: "display: block; font-size: 13px; font-weight: 500; color: #1A1A17; margin-bottom: 5px;" %>
          <%= f.password_field :password,
                autocomplete: "current-password",
                placeholder: "••••••••",
                style: "display: block; width: 100%; padding: 9px 11px; border: 1px solid #E3E3DF; border-radius: 6px; font-size: 14px; color: #1A1A17; background: white; box-sizing: border-box; outline: none;" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px;">
            <%= f.check_box :remember_me, style: "width: 14px; height: 14px; accent-color: #0a7065;" %>
            <%= f.label :remember_me, "Remember me", style: "font-size: 13px; color: #6B6B64; cursor: pointer;" %>
          </div>
        <% end %>

        <%= f.submit "Sign in",
              style: "display: block; width: 100%; padding: 10px 16px; background: #0a7065; color: white; border: none; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: center;" %>

      <% end %>

      <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #E3E3DF; font-size: 13px; color: #6B6B64; text-align: center; line-height: 1.8;">
        <%= render "devise/shared/links" %>
      </div>

    </div>
  </div>
</div>
